<mxfile host="app.diagrams.net">
  <diagram name="Fitness Assistant AWS Architecture (MVP)" id="fitness-assistant-mvp">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1350" pageHeight="1050" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <!-- Title -->
        <mxCell id="title" value="Fitness Assistant — AWS MVP Architecture" style="text;html=1;fontSize=20;fontStyle=1;align=left;verticalAlign=middle;fontColor=#232F3E;" vertex="1" parent="1">
          <mxGeometry x="180" y="0" width="700" height="30" as="geometry" />
        </mxCell>

        <!-- End user -->
        <mxCell id="user" value="End User&#10;(Browser)" style="shape=umlActor;verticalLabelPosition=bottom;verticalAlign=top;html=1;outlineConnect=0;fontSize=11;" vertex="1" parent="1">
          <mxGeometry x="50" y="420" width="40" height="60" as="geometry" />
        </mxCell>

        <!-- AWS Cloud boundary -->
        <mxCell id="cloud" value="AWS Cloud — Region: &lt;YOUR_AWS_REGION&gt;" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#232F3E;dashed=1;verticalAlign=top;align=left;fontColor=#232F3E;fontSize=14;fontStyle=1;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="180" y="40" width="970" height="870" as="geometry" />
        </mxCell>

        <!-- VPC boundary -->
        <mxCell id="vpc" value="VPC — 10.0.0.0/16" style="rounded=0;whiteSpace=wrap;html=1;fillColor=none;strokeColor=#248814;dashed=1;verticalAlign=top;align=left;fontColor=#248814;fontSize=12;fontStyle=1;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="210" y="90" width="760" height="790" as="geometry" />
        </mxCell>

        <!-- Public subnet -->
        <mxCell id="pubsubnet" value="Public Subnet — 10.0.1.0/24 (AZ-A)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E6F2F8;strokeColor=#147EBA;dashed=0;verticalAlign=top;align=left;fontColor=#147EBA;fontSize=12;fontStyle=1;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="230" y="140" width="360" height="710" as="geometry" />
        </mxCell>

        <!-- Private subnet(s) -->
        <mxCell id="privsubnet" value="Private Subnets — 10.0.11.0/24, 10.0.12.0/24 (AZ-A/AZ-B) — DB Subnet Group" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#E9F3E6;strokeColor=#248814;dashed=0;verticalAlign=top;align=left;fontColor=#248814;fontSize=11;fontStyle=1;spacingLeft=10;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="620" y="140" width="330" height="240" as="geometry" />
        </mxCell>

        <!-- Internet Gateway -->
        <mxCell id="igw" value="Internet Gateway" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#8C4FFF;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.internet_gateway;" vertex="1" parent="1">
          <mxGeometry x="385" y="175" width="50" height="50" as="geometry" />
        </mxCell>

        <!-- EC2 instance -->
        <mxCell id="ec2" value="EC2 Instance&#10;(single host, Docker Compose)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.ec2;" vertex="1" parent="1">
          <mxGeometry x="385" y="265" width="50" height="50" as="geometry" />
        </mxCell>

        <!-- Docker Compose stack box -->
        <mxCell id="stack" value="Docker Compose stack (containers on this EC2 host)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#545B64;dashed=1;verticalAlign=top;align=left;fontColor=#545B64;fontSize=11;fontStyle=1;spacingLeft=8;spacingTop=6;" vertex="1" parent="1">
          <mxGeometry x="250" y="345" width="320" height="480" as="geometry" />
        </mxCell>

        <mxCell id="c-frontend" value="Frontend&#10;(Nginx)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="265" y="390" width="95" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c-gateway" value="API Gateway" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="370" y="390" width="95" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c-auth" value="Auth Service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="475" y="390" width="80" height="50" as="geometry" />
        </mxCell>

        <mxCell id="c-user" value="User Service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="265" y="470" width="95" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c-fitness" value="Fitness&#10;Service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="370" y="470" width="95" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c-ai" value="AI Service&#10;(+ Ollama, Qdrant)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="475" y="470" width="80" height="50" as="geometry" />
        </mxCell>

        <mxCell id="c-payment" value="Payment&#10;Service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="265" y="550" width="95" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c-gym" value="Gym Service" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="370" y="550" width="95" height="50" as="geometry" />
        </mxCell>
        <mxCell id="c-redis" value="Redis" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#dae8fc;strokeColor=#6c8ebf;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="475" y="550" width="80" height="50" as="geometry" />
        </mxCell>

        <mxCell id="c-note" value="backend/gateway is an application-level Node.js/Express reverse proxy shipped with the source code — NOT the AWS-managed Amazon API Gateway service. See Proposal §12." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=9;align=left;verticalAlign=top;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="265" y="630" width="290" height="60" as="geometry" />
        </mxCell>

        <mxCell id="c-uploads" value="EBS volume: local file uploads&#10;(InBody photos, PT docs — no S3 yet)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=9;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="265" y="700" width="290" height="40" as="geometry" />
        </mxCell>

        <!-- RDS -->
        <mxCell id="rds" value="Amazon RDS&#10;for PostgreSQL" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#3334B9;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.rds;" vertex="1" parent="1">
          <mxGeometry x="755" y="230" width="50" height="50" as="geometry" />
        </mxCell>
        <mxCell id="rds-note" value="database-per-service:&#10;gymcoach_auth, _user, _fitness,&#10;_ai, _payment, _gym" style="text;html=1;fontSize=9;align=center;verticalAlign=top;fontColor=#248814;" vertex="1" parent="1">
          <mxGeometry x="680" y="290" width="200" height="60" as="geometry" />
        </mxCell>

        <!-- Regional services (outside VPC) -->
        <mxCell id="ecr" value="Amazon ECR" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#ED7100;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.registry;" vertex="1" parent="1">
          <mxGeometry x="1040" y="150" width="50" height="50" as="geometry" />
        </mxCell>

        <mxCell id="iamrole" value="IAM Role&#10;(EC2 instance profile)" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.role;" vertex="1" parent="1">
          <mxGeometry x="1040" y="270" width="50" height="50" as="geometry" />
        </mxCell>

        <mxCell id="secrets" value="AWS Secrets&#10;Manager" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#DD344C;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.secrets_manager;" vertex="1" parent="1">
          <mxGeometry x="1040" y="390" width="50" height="50" as="geometry" />
        </mxCell>

        <mxCell id="cloudwatch" value="Amazon&#10;CloudWatch" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.cloudwatch_2;" vertex="1" parent="1">
          <mxGeometry x="1040" y="510" width="50" height="50" as="geometry" />
        </mxCell>

        <mxCell id="sns" value="Amazon SNS" style="sketch=0;outlineConnect=0;fontColor=#232F3E;gradientColor=none;fillColor=#E7157B;strokeColor=none;dashed=0;verticalLabelPosition=bottom;verticalAlign=top;align=center;html=1;fontSize=11;fontStyle=0;aspect=fixed;shape=mxgraph.aws4.resourceIcon;resIcon=mxgraph.aws4.simple_notification_service;" vertex="1" parent="1">
          <mxGeometry x="1040" y="630" width="50" height="50" as="geometry" />
        </mxCell>

        <!-- Email (outside AWS cloud) -->
        <mxCell id="email" value="Email&#10;(Reviewer / on-call)" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#f5f5f5;strokeColor=#666666;fontSize=10;" vertex="1" parent="1">
          <mxGeometry x="1210" y="632" width="90" height="46" as="geometry" />
        </mxCell>

        <!-- Legend / scope note -->
        <mxCell id="legend" value="Scope note: chat-service is NOT part of this MVP (real-time Socket.IO infrastructure, deferred). payment-service runs with PAYMENT_PROVIDER=MOCK (no real payment gateway). See Proposal §8/§9." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#fff2cc;strokeColor=#d6b656;fontSize=11;align=left;verticalAlign=top;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="180" y="930" width="970" height="50" as="geometry" />
        </mxCell>

        <!-- Edges -->
        <mxCell id="e-user-igw" value="HTTP/HTTPS&#10;(port 80, no domain yet)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;" edge="1" parent="1" source="user" target="igw">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-igw-ec2" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;" edge="1" parent="1" source="igw" target="ec2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-ec2-rds" value="5432 (Prisma)&#10;sslmode=require" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;" edge="1" parent="1" source="ec2" target="rds">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-ec2-ecr" value="docker pull&#10;(image)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;" edge="1" parent="1" source="ec2" target="ecr">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-role-ec2" value="attached to" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;dashed=1;fontSize=9;" edge="1" parent="1" source="iamrole" target="ec2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-ec2-secrets" value="fetch secrets&#10;at deploy" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;" edge="1" parent="1" source="ec2" target="secrets">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-ec2-cw" value="logs &amp; metrics&#10;(CloudWatch Agent)" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;" edge="1" parent="1" source="ec2" target="cloudwatch">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-cw-sns" value="Alarm" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;" edge="1" parent="1" source="cloudwatch" target="sns">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="e-sns-email" value="Email notify" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;fontSize=9;" edge="1" parent="1" source="sns" target="email">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>
</mxfile>
