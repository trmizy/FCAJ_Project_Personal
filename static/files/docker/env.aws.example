# Reference example only. Real values must come from AWS Secrets Manager
# at deploy time (see content/5-Workshop/5.11-IAM-Secrets/), not from a
# plaintext file checked into any repository.
#
# Variable names below mirror the real .env.example in the fitness-assistant
# source repository (root-level, shared across services). Only MVP-relevant
# variables are listed here — see the source repo for the full list.

# --- Database (Amazon RDS) ---
POSTGRES_HOST=<YOUR_RDS_ENDPOINT>
POSTGRES_PORT=5432
POSTGRES_USER=<YOUR_DATABASE_USER>
POSTGRES_PASSWORD=<FROM_SECRETS_MANAGER>
DATABASE_URL=postgresql://<YOUR_DATABASE_USER>:<FROM_SECRETS_MANAGER>@<YOUR_RDS_ENDPOINT>:5432/<YOUR_DATABASE_NAME>

# --- Redis (container on EC2 for MVP) ---
REDIS_HOST=redis
REDIS_PORT=6379
QUEUE_REDIS_HOST=redis
QUEUE_REDIS_PORT=6379

# --- Qdrant (container on EC2 for MVP) ---
QDRANT_HOST=qdrant
QDRANT_PORT=6333

# --- JWT ---
JWT_SECRET=<FROM_SECRETS_MANAGER>
JWT_REFRESH_SECRET=<FROM_SECRETS_MANAGER>
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d
INTERNAL_SERVICE_SECRET=<FROM_SECRETS_MANAGER>

# --- Service URLs (internal Docker network) ---
AUTH_SERVICE_URL=http://auth-service:3001
FITNESS_SERVICE_URL=http://fitness-service:3002
AI_SERVICE_URL=http://ai-service:3003
USER_SERVICE_URL=http://user-service:3004

# --- LLM / AI (Ollama, self-hosted on EC2 for MVP) ---
LLM_PROVIDER=ollama
LLM_BASE_URL=http://ollama:11434
LLM_MODEL=llama3.2:3b
EMBEDDING_MODEL=nomic-embed-text

# --- Anthropic (InBody photo extraction, user-service only) ---
ANTHROPIC_API_KEY=<FROM_SECRETS_MANAGER>
INBODY_VISION_MODEL=claude-sonnet-4-6

# --- Gateway / Node ---
NODE_ENV=production
PORT=3000
LOG_LEVEL=info
CORS_ORIGIN=<YOUR_FRONTEND_ORIGIN>

# --- Rate limiting ---
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=100
